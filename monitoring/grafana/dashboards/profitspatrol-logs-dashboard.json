          "expr": "((sum(rate({service=~\"$service\", env=~\"$env\"} | json | status >= 500 [5m])) or vector(0)) / (sum(rate({service=~\"$service\", env=~\"$env\"} | json | status > 0 [5m])) or vector(1))) * 100",
